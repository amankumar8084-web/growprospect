# Node Environment
NODE_ENV=development
PORT=3001

# Business Discovery (Confirmed: Geoapify Places API)
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Website Crawling & Enrichment (Crawlee + Playwright)
CRAWLEE_HEADLESS=true
CRAWLEE_MAX_CONCURRENCY=4
CRAWLEE_REQUEST_TIMEOUT_SECS=30
PLAYWRIGHT_TIMEOUT_MS=15000

# Email Verification Provider (Provider OPEN)
EMAIL_VERIFICATION_PROVIDER=mock
EMAIL_VERIFICATION_API_KEY=your_email_verification_key_here

# Database Configuration (PostgreSQL PROPOSED)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lead_discovery_db

# Web App Endpoint
WEB_ORIGIN=http://localhost:5173

# Authentication Credentials (Admin Access)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=your_secure_password_here
